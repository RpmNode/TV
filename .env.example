# ── Binance API ──────────────────────────────────────────────────────────────
# Genera tus claves en: https://www.binance.com/es/my/settings/api-management
BINANCE_API_KEY=TU_API_KEY_AQUI
BINANCE_API_SECRET=TU_API_SECRET_AQUI

# ── Seguridad webhook ────────────────────────────────────────────────────────
# Token secreto que TradingView enviará en el campo "secret" del JSON.
# Debe coincidir exactamente con el valor del input "Token secreto webhook"
# en el script PineScript de TradingView.
WEBHOOK_SECRET=MI_TOKEN_SECRETO

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=5000

# ── Modo ─────────────────────────────────────────────────────────────────────
# true  → usa la Testnet de Binance (recomendado para pruebas)
# false → PRODUCCIÓN real con dinero real
TESTNET=true
